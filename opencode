#!/bin/sh
set -eu

# get container repo location
self=$(readlink -f -- "$0" 2>/dev/null || printf '%s\n' "$0")
repo_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)

IMAGE="${OPENCODE_IMAGE:-opencode:standard}"
VOLUME="${OPENCODE_VOLUME:-opencode-data}"
USERCONFIG="${OPENCODE_USERCONFIG:-$repo_dir/.config/}"
VARIANT="${OPENCODE_VARIANT:-}"
BASE_VARIANT="base"
SECRET_NAME="opencode_api_key"

die() {
	echo "error: $*" >&2
	exit 2
}

# Options are consumed until the first non-option argument; everything from
# there on is passed to the OpenCode CLI unchanged.
while [ $# -gt 0 ]; do
	case "$1" in
	-v | --variant)
		[ $# -ge 2 ] || die "$1 needs a variant name"
		VARIANT="$2"
		shift 2
		;;
	--variant=*)
		VARIANT="${1#*=}"
		shift
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

if [ -n "$VARIANT" ]; then
	case "$VARIANT" in
	*[!a-z0-9-]*) die "invalid variant '$VARIANT' (expected [a-z0-9-])" ;;
	esac

	if [ "$VARIANT" = "$BASE_VARIANT" ]; then
		die "variant '$BASE_VARIANT' is reserved for the shared base image; build it with 'make base'"
	fi

	if [ ! -f "$repo_dir/variants/$VARIANT.containerfile" ]; then
		available=$(ls "$repo_dir"/variants/*.containerfile 2>/dev/null |
			sed 's#.*/##; s#\.containerfile$##' |
			grep -vx "$BASE_VARIANT" | tr '\n' ' ')
		die "unknown variant '$VARIANT' (available: ${available:-none})"
	fi

	IMAGE="opencode:$VARIANT"
fi

if [ ! -d "$USERCONFIG" ]; then
	mkdir -p "$USERCONFIG"
	chmod 700 "$USERCONFIG"
fi

# Run the container with the secret and configuration mount only
# when the Podman secret exists.
run_container() {
	if podman secret exists "$SECRET_NAME"; then
		echo "Using Podman secret: $SECRET_NAME" >&2

		exec podman run --rm -it \
			--init \
			--userns=keep-id \
			--cap-drop=ALL \
			--security-opt=no-new-privileges \
			-v "$(pwd):/workspace:Z" \
			-v "${VOLUME}:/home/node/.local/share/opencode:U" \
			-v "${USERCONFIG}:/home/node/.config:Z" \
			-v "$repo_dir/opencode.json:/home/node/.config/opencode/opencode.json:ro,Z" \
			-e GIT_CONFIG_GLOBAL=/home/node/.config/git/config \
			--secret "$SECRET_NAME" \
			--tmpfs /home/node/.local/share/opencode/snapshot:rw,mode=1777 \
			-w /workspace \
			"$IMAGE" "$@"
	fi

	echo "No Podman secret '$SECRET_NAME' found; starting without API key configuration." >&2

	exec podman run --rm -it \
		--init \
		--userns=keep-id \
		--cap-drop=ALL \
		--security-opt=no-new-privileges \
		-v "$(pwd):/workspace:Z" \
		-v "${VOLUME}:/home/node/.local/share/opencode:U" \
		-v "${USERCONFIG}:/home/node/.config:Z" \
		-e GIT_CONFIG_GLOBAL=/home/node/.config/git/config \
		--tmpfs /home/node/.local/share/opencode/snapshot:rw,mode=1777 \
		-w /workspace \
		"$IMAGE" "$@"
}

run_container "$@"
